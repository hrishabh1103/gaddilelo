# ==========================================
# GaadiLelo.com - Environment Configuration
# ==========================================

# Brand Configuration (Configurable brand name)
BRAND_NAME=GaadiLelo
BRAND_TAGLINE="Buy Together. Save Together."
DEFAULT_PILOT_CITY=Indore
DEFAULT_STATE=Madhya Pradesh

# Frontend Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BRAND_NAME=GaadiLelo
NEXT_PUBLIC_BRAND_TAGLINE="Buy Together. Save Together."
NEXT_PUBLIC_PILOT_CITY=Indore

# Backend Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-this-in-production-super-secret-key-gaadilelo-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / Supabase / SQLite for local development)
# For Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres
# For Local SQLite out-of-the-box dev/test:
DATABASE_URL=sqlite+aiosqlite:///./gaadilelo.db

# Supabase Auth & Storage (Optional for production cloud integration)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Notification Integrations (Extensible interface - credentials optional in dev)
SMS_PROVIDER=mock # options: mock, twilio, msg91, kaleyra
SMS_API_KEY=
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
EMAIL_PROVIDER=mock # options: mock, resend, sendgrid, smtp
EMAIL_API_KEY=
