# GaadiLelo Backend Production Environment Configuration

# Database: SQLite for local dev, PostgreSQL for Production / Supabase
# Example for Supabase: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./gaadilelo.db

# Authentication Security
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://gaadilelo.com,https://www.gaadilelo.com

# Optional Supabase Integration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Communications & Notifications
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
WHATSAPP_ENABLED=false

